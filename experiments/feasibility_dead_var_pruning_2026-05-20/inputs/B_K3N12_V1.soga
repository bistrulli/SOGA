data feat1 = [2, 1, 5, 4, 4, 3, 2, 9, 2, 10, 7, 1];
data feat2 = [1, 2, 4, 4, 9, 10, 1, 9, 4, 9, 7, 4];
data feat3 = [8, 10, 5, 1, 3, 7, 6, 5, 3, 4, 6, 2];

array[3] w;
array[12] mu;

for i in range(3) {
    w[i] = gm([1.], [0.], [1.]);
} end for;

for i in range(12) {
    mu[i] = feat1[i]*w[0] + feat2[i]*w[1] + feat3[i]*w[2];
    mu[i] = gm([1.], [0.], [0.1]) + mu[i];
} end for;

observe(mu[0] > 0);
observe(mu[1] > 0);
observe(mu[2] > 0);
observe(mu[3] > 0);
observe(mu[4] > 0);
observe(mu[5] > 0);
observe(mu[6] > 0);
observe(mu[7] > 0);
observe(mu[8] > 0);
observe(mu[9] > 0);
observe(mu[10] > 0);
observe(mu[11] > 0);
