array[3] w;

for i in range(3) {
    w[i] = gm([1.], [0.], [1.]);
} end for;

tmp = feat1[0]*w[0] + feat2[0]*w[1] + feat3[0]*w[2];
tmp = gm([1.], [0.], [0.1]) + tmp;
observe(tmp > 0);

