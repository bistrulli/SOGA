array[3] w;
array[75] mu;

for i in range(3) {
    w[i] = gm([1.], [0.], [1.]);
} end for;

for i in range(75) {
    mu[i] = feat1[i]*w[0] + feat2[i]*w[1] + feat3[i]*w[2];
    mu[i] = gm([1.], [0.], [0.1]) + mu[i];
} end for;

