data feat1 = [2, 1, 5, 4, 4, 3, 2, 9, 2, 10, 7, 1, 1, 2, 4, 4, 9, 10, 1, 9, 4, 9, 7, 4, 8];
data feat2 = [10, 5, 1, 3, 7, 6, 5, 3, 4, 6, 2, 2, 7, 2, 6, 6, 10, 5, 1, 8, 9, 2, 7, 2, 9];
data feat3 = [5, 10, 6, 10, 4, 2, 1, 4, 5, 2, 4, 2, 7, 5, 8, 6, 3, 6, 6, 4, 5, 2, 10, 3, 9];

array[3] w;
array[25] mu;

for i in range(3) {
    w[i] = gm([1.], [0.], [1.]);
} end for;

for i in range(25) {
    mu[i] = feat1[i]*w[0] + feat2[i]*w[1] + feat3[i]*w[2];
    mu[i] = gm([1.], [0.], [0.1]) + mu[i];
} end for;

observe(mu[0] < 0);
observe(mu[1] < 0);
observe(mu[2] < 0);
observe(mu[3] < 0);
observe(mu[4] < 0);
observe(mu[5] < 0);
observe(mu[6] < 0);
observe(mu[7] < 0);
observe(mu[8] < 0);
observe(mu[9] < 0);
observe(mu[10] < 0);
observe(mu[11] < 0);
observe(mu[12] < 0);
observe(mu[13] < 0);
observe(mu[14] < 0);
observe(mu[15] < 0);
observe(mu[16] < 0);
observe(mu[17] < 0);
observe(mu[18] < 0);
observe(mu[19] < 0);
observe(mu[20] < 0);
observe(mu[21] < 0);
observe(mu[22] < 0);
observe(mu[23] < 0);
observe(mu[24] < 0);
